#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/app-bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y docker.io python3-venv

python3 -m venv /opt/oci-cli
/opt/oci-cli/bin/pip install --quiet oci-cli

# A politica pode levar alguns minutos para valer: tenta por ate ~10 minutos
get_secret() {
  for i in $(seq 1 30); do
    if /opt/oci-cli/bin/oci --auth instance_principal secrets secret-bundle get \
         --secret-id "$1" --query 'data."secret-bundle-content".content' \
         --raw-output | base64 -d; then
      return 0
    fi
    sleep 20
  done
  return 1
}

DB_PASSWORD=$(get_secret "${db_secret_id}")
JWT_SECRET=$(get_secret "${jwt_secret_id}")

umask 077
mkdir -p /etc/app
printf 'DB_URL=jdbc:mysql://%s:3306/diagramcode\n' "${db_host}" > /etc/app/app.env
printf 'DB_USERNAME=diagramcode_app\n' >> /etc/app/app.env
printf 'DB_PASSWORD=%s\n' "$DB_PASSWORD" >> /etc/app/app.env
printf 'JWT_SECRET=%s\n' "$JWT_SECRET" >> /etc/app/app.env

docker rm -f app 2>/dev/null || true
docker run -d --name app --restart unless-stopped -p 8080:8080 \
  --env-file /etc/app/app.env "${image}"