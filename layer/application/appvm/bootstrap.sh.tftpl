#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/app-bootstrap.log) 2>&1

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
apt-get install -y docker.io python3-venv curl
systemctl enable --now docker

python3 -m venv /opt/oci-cli
/opt/oci-cli/bin/pip install --quiet oci-cli

# Config lida pelo app-deploy.sh (só IDs e endereços, nenhum segredo)
mkdir -p /etc/app
umask 077
cat > /etc/app/deploy.conf <<'DEPLOY_CONF_EOF'
DB_HOST=${db_host}
DB_SECRET_ID=${db_secret_id}
JWT_SECRET_ID=${jwt_secret_id}
IMAGE_REPO=${image_repo}
DOMAIN=${domain}
ACME_STAGING=${acme_staging}
DEPLOY_CONF_EOF
umask 022

# Script de deploy (conteúdo vem de files/app-deploy.sh)
cat > /usr/local/bin/app-deploy.sh <<'APP_DEPLOY_EOF'
${deploy_script}
APP_DEPLOY_EOF
chmod 755 /usr/local/bin/app-deploy.sh

# Monitoramento (Prometheus + Grafana): arquivos vêm de files/monitoring/
# (cada arquivo chega compactado em base64; a senha do Grafana é gerada pelo próprio monitoring-up.sh)
mkdir -p /opt/monitoring
%{ for path, content in monitoring_files ~}
mkdir -p "$(dirname "/opt/monitoring/${path}")"
echo '${content}' | base64 -d | gunzip > "/opt/monitoring/${path}"
%{ endfor ~}
chmod 755 /opt/monitoring/monitoring-up.sh

cat > /etc/systemd/system/app-deploy.service <<'UNIT_EOF'
[Unit]
Description=Deploy da versao prod do app
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/app-deploy.sh
UNIT_EOF

cat > /etc/systemd/system/app-deploy.timer <<'UNIT_EOF'
[Unit]
Description=Checa nova versao do app a cada 5 min

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min

[Install]
WantedBy=timers.target
UNIT_EOF

systemctl daemon-reload
systemctl enable --now app-deploy.timer

# Primeiro deploy. Se a policy do IAM ainda não propagou, o timer tenta de novo.
/usr/local/bin/app-deploy.sh || true

# Sobe Prometheus + Grafana (os containers voltam sozinhos em reboot: --restart unless-stopped)
/opt/monitoring/monitoring-up.sh || true
